# Copy this file to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=3000

# Sessions and OAuth
VITE_APP_ID=
JWT_SECRET=replace-with-a-long-local-development-secret
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=

# Database
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# Hosted-service replacements or compatible external adapters
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Payments and optional telemetry
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
