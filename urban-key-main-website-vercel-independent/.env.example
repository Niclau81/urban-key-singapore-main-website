# Copy this file to .env.local for local development. Do not commit .env.local.
# Values beginning VITE_ are public browser configuration values, never server secrets.
VITE_APP_TITLE=UrbanKey Singapore
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_GOOGLE_MAPS_API_KEY=YOUR_BROWSER_RESTRICTED_GOOGLE_MAPS_KEY
VITE_GOOGLE_MAPS_MAP_ID=YOUR_GOOGLE_MAPS_MAP_ID_FOR_3D_MODE
# Server-side only: do not prefix with VITE_ and never commit a real value.
# Configure these in Vercel to enable the bounded /api/assistant response path.
OPENAI_API_KEY=YOUR_SERVER_SIDE_MODEL_PROVIDER_KEY
OPENAI_MODEL=gpt-4o-mini
