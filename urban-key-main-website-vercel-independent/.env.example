# Copy this file to .env.local for local development. Do not commit .env.local.
# Values beginning VITE_ are public browser configuration values, never server secrets.
VITE_APP_TITLE=UrbanKey Singapore
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_GOOGLE_MAPS_API_KEY=YOUR_BROWSER_RESTRICTED_GOOGLE_MAPS_KEY
VITE_GOOGLE_MAPS_MAP_ID=YOUR_GOOGLE_MAPS_MAP_ID_FOR_3D_MODE
